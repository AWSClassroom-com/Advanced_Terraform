# lab1/state-infra/terraform.tfvars.example
#
# Copy to terraform.tfvars and fill in your assigned AWS login ID.

# REQUIRED — names the S3 state bucket and every resource this lab creates.
# Pattern: userNN (two digits). Example: user07
user_id = "userXX"

# Optional — the region you work in. Set this only if your instructor
# assigned you something other than us-east-2.
# primary_region = "us-east-2"

# Optional — the region your state bucket lives in. Only read by the
# cross-state data source in Task 4. The backend gets this value from
# -backend-config at init time instead, because a backend block cannot
# read variables.
# bucket_region = "us-east-2"

# Set this at Step 18. Run `terraform output state_bucket_name`
# in this directory to get the actual bucket name, then paste it here so
# Task 4's terraform_remote_state data source can read the networking outputs
# from the lab1/networking state.
# state_bucket_name = "userXX-terraform-state-abc123"
