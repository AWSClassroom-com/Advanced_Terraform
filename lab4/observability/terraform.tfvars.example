# lab4-observability/terraform.tfvars.example
#
# Copy to terraform.tfvars and fill in. All three variables are required —
# variables.tf declares them with no defaults.
#
# IMPORTANT: `account` here should be the SAME value you used as
# `student_id` in Labs 1 and 3 (e.g. user07). Lab 4's dashboard widgets
# reference Lab 3 resources by `${var.account}-terraform-validate` etc. —
# if account here doesn't match Lab 3's student_id, every widget shows
# "No data".

region            = ""                                  # Your assigned region (e.g. us-east-2)
account           = "studentXX"                         # SAME as student_id in Labs 1 + 3 (e.g. user07)
state_bucket_name = "studentXX-terraform-state-SUFFIX"  # Exact bucket name from Lab 1 `terraform output`
