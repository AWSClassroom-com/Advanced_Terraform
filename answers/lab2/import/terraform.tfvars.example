# lab2/import/terraform.tfvars.example
#
# Copy to terraform.tfvars and fill in.

user_id        = "userxx"     # Your assigned AWS login ID (e.g. user07)
primary_region = "us-east-2"  # The region the resources you are importing live in

# VPC stack resource IDs — from `terraform output` in lab2/existing-stack/.
vpc_id              = "vpc-0xxxxxxxxxxxxxxxx"
subnet_id           = "subnet-0xxxxxxxxxxxxxxxx"
internet_gateway_id = "igw-0xxxxxxxxxxxxxxxx"
route_table_id      = "rtb-0xxxxxxxxxxxxxxxx"

# Security group + 3 rule IDs.
# Security group and rule IDs - also from `terraform output` in lab2/existing-stack/.
# That stack emits security_group_id, sg_rule_http_id, sg_rule_ssh_id and
# sg_rule_egress_id by name, so no describe- calls are needed.
security_group_id = "sg-0xxxxxxxxxxxxxxxx"
sg_rule_http_id   = "sgr-0xxxxxxxxxxxxxxxx"
sg_rule_ssh_id    = "sgr-0xxxxxxxxxxxxxxxx"
sg_rule_egress_id = "sgr-0xxxxxxxxxxxxxxxx"

# Optional overrides:
# vpc_cidr           = "192.168.0.0/20"
# public_subnet_cidr = "192.168.0.0/24"
