# terraform.tfvars
# Replace userXX with your assigned AWS login ID
# Replace SUFFIX with the random suffix from your Lab 1 terraform output

user_id = "userXX"

# Optional overrides:
# primary_region = "us-east-2"   # where the pipeline itself runs
# bucket_region  = "us-east-2"   # where your state bucket lives

# This value comes from Lab 1 output. After running `terraform apply` in
# lab1/state-infra, run `terraform output` to get your actual value.
# Then pass the bucket and its region to `terraform init` with -backend-config,
# as Step 4 shows - a backend block cannot read variables, so nothing in
# providers.tf needs editing.

state_bucket_name = "userXX-terraform-state-SUFFIX"
