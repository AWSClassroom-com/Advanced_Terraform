# lab2-day1-vpc-lean/terraform.tfvars.example
#
# Copy to terraform.tfvars and set user_id to your assigned AWS login ID.
# All other values default to Day 1-2's tfvars.

user_id = "userxx"   # REPLACE: your assigned AWS login ID (e.g. user07)

# Optional overrides — defaults match Day 1-2:
primary_region       = "us-east-2"   # the region you work in
# vpc_name             = "vpc"
# vpc_cidr             = "192.168.0.0/20"
# public_subnet_a_name = "public-subnet-a"
# public_subnet_a_cidr = "192.168.0.0/24"
# route_table_name     = "public-route-table"
